# Copy to .env. The defaults run the whole stack with no credentials at all.

# --- PayPal (docs/specs/0004) ---
PAYPAL_MODE=mock                  # mock | sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- AI (docs/specs/0006) ---
AI_MODE=replay                    # replay (recorded responses, no key) | live
AI_PROVIDER=                      # nvidia (D1, spec 0006); also built in: gemini, groq, openrouter
AI_MODEL=                         # exactly nvidia/nemotron-3.5-lightning-30b-a3b; send enable_thinking: false
AI_API_KEY=
# Optional backup, tried once when the primary fails in a way another model can fix: the model is gone (404/410), the free
# tier is rate limited (429), the provider errors (5xx) or times out. A bad key or a rejected request is never hidden.
# Another model on the same provider needs only AI_FALLBACK_MODEL. A different provider (for example Groq) also needs its
# own key; its endpoint is built in. Check it with `pnpm ai:check`.
AI_FALLBACK_PROVIDER=             # e.g. groq (leave empty for the same provider as AI_PROVIDER)
AI_FALLBACK_MODEL=                # e.g. openai/gpt-oss-120b on groq
AI_FALLBACK_API_KEY=              # the backup provider's own key (never the primary's)
AI_FALLBACK_BASE_URL=             # only for a backup provider with no built-in endpoint
AI_BASE_URL=                      # only for a provider with no built-in endpoint (any OpenAI-compatible endpoint)
AI_DAILY_CALL_LIMIT=500           # live model calls per UTC day, per process; 0 = off (then checkout steps up)

# --- Data ---
POSTGRES_PASSWORD=poi
DATABASE_URL=postgres://poi:poi@postgres:5432/poi

# --- Merchant: carts must name this merchant; Cart Mandates are signed with this key ---
MERCHANT_ID=merchant-trailhead
MERCHANT_KEY_ID=merchant-1
# pnpm keys:gen (PEM, one line with \n escapes). Required when PAYPAL_MODE=sandbox.
MERCHANT_SIGNING_KEY=

# --- Buyer agent (apps/buyer): signs Payment Mandates. Never holds PayPal credentials ---
# pnpm keys:gen (PEM, one line with \n escapes). Empty = a new agent key per process (fine locally).
AGENT_SIGNING_KEY=
AGENT_PLATFORM=Northstar
# With OPERATOR_TOKEN set below, the shop registers its agent key with the API on first checkout.

# --- Dashboard (docs/specs/0007) ---
# Operator dispute actions (submit evidence, accept claim). Both unset = actions are off.
OPERATOR_TOKEN=                   # long random string; the dashboard server sends it, browsers never see it
OPERATOR_PASSWORD=                # dashboard login (user "operator") before any action
AG_STUDIO_LICENSE_KEY=

# --- Public URLs on the team server (docs/specs/0008) ---
PUBLIC_BASE_URL=http://localhost:3000
# Where step-up approval links open (the shop's /approve page). No email provider yet.
BUYER_PUBLIC_URL=http://localhost:3001
# Profiles to start in addition to the default services. On Dokploy set `backup` to run the nightly database dump (and not
# caddy); plain Compose on your own server uses `docker compose --profile server` instead. Leave empty for a local run.
COMPOSE_PROFILES=
# Where the backup service keeps its dumps: empty means the ./backups folder. On Dokploy set `backups`, a named volume that
# survives deploys (docs/SETUP.md, "Setting up backups on Dokploy").
BACKUP_DIR=
# 1 logs each step-up approval link (it carries a secret token), for local development without an email provider.
# Leave empty on a server: the link is then not logged, and the request log redacts the token in /stepup/<token> paths.
LOG_STEPUP_LINKS=
# 1 turns on voice input in the shop (docs/specs/0010): speak a request and the agent fills in the limits; you still sign.
BUYER_VOICE=
# 1 turns on the shop assistant (docs/specs/0010): answers about the store, your limits and refusals. It can't sign, buy or pay.
BUYER_CHAT=
# Live model calls the assistant may make per UTC day, per process (default 150; 0 = answer from the store's data only).
BUYER_CHAT_DAILY_LIMIT=
# 1 only behind Caddy or a Cloudflare Tunnel, so rate limits see the client IP (docs/SETUP.md §4)
TRUST_PROXY=
API_HOST=api.example.com
SHOP_HOST=shop.example.com
OPS_HOST=ops.example.com
# Host ports (127.0.0.1 only). Change them if 3000-3002 are already taken on the host.
API_HOST_PORT=3000
SHOP_HOST_PORT=3001
OPS_HOST_PORT=3002
